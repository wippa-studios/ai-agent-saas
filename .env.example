# ─────────────────────────────────────────────────────────────
# Copy to .env  →  cp .env.example .env
# EVERY variable here is OPTIONAL. Leave a value blank (or the
# whole line commented) and the matching feature stays off and
# the app falls back to its offline / local behaviour.
#   GEMINI  blank -> OFFLINE_FALLBACK (regex + keyword routing)
#   STRIPE  blank -> billing endpoints return a clear 400
#   SUPABASE blank -> local SQLite file (agent_saas.db)
# ⚠️ .env holds real API keys — it is git-ignored. Never commit it.
# ─────────────────────────────────────────────────────────────

# Real AI (Google Gemini) — https://aistudio.google.com
# Sets ai_mode = "GEMINI" instead of "OFFLINE_FALLBACK"
GEMINI_API_KEY=

# Production database (Supabase) — https://supabase.com
# Both are required to switch; also run the SQL script in the README first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing — https://dashboard.stripe.com/products
# Create the Starter / Pro Products and paste their Price IDs below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# From `stripe listen` — used to verify the /api/v1/billing/webhook signature
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the customer after checkout / from the billing portal.
# Must match the origin you serve index.html on — the README's double-click
# (file://) flow will NOT work for redirects.
FRONTEND_URL=http://localhost:5500
